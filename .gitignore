# Secrets. Loaded by web/server.py, must never reach a commit.
.env

# Trees. data/demo/ is committed — PLAYBOOKS.md quotes it line by line and
# demo.py --force is the only thing that should rewrite it. The directory has
# to be un-ignored before git will look inside it at all. Everything else under
# data/ is disposable scratch (data/tree/ is loom.py's default) or local history.
data/*
!data/demo/

# Local working notes, deliberately out of repo.
daniel-notes*.md

# Environment and caches.
.venv/
__pycache__/
*.py[cod]

# Tooling state. settings.json is shared if it ever exists; the .local one is not.
.claude/settings.local.json
.DS_Store
